# MiniMax 国内版 TTS 与音色快速复刻（同一国内账号的音色 ID 才能用于合成）
TTS_PROVIDER=minimax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_GROUP_ID=

# DeepSeek 大模型（用于生成播报内容）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 部署配置。开发时留空，系统会使用本地 SQLite。
# DATABASE_URL=postgresql+psycopg://xiaonuan:replace_me@db:5432/xiaonuan
# CORS_ORIGINS=https://app.your-domain.com,capacitor://localhost
# APP_ENV=production
